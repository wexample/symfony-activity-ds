{#- The last entries of a history, newest first, as a timeline: the short
    story a page about the subject shows. The way to the whole of it is the
    including block's, in its footer — a body cannot draw it. Fed with the
    entries themselves (`entries`), events and field changes alike, as
    ActivityRepository::findRecent() returns them. A
    failure, a refusal, a denial is drawn in the danger tone; a change says
    which fields it touched. -#}
{%- set domain = 'WexampleSymfonyActivityDsBundle.common.activity::' -%}
{%- if entries is empty -%}
    <p class="text-secondary">{{ (domain ~ 'empty') | trans }}</p>
{%- else -%}
    {%- set items = [] -%}
    {%- for entry in entries -%}
        {%- set body = entry.change ? include('@WexampleSymfonyActivityDsBundle/partials/changes.html.twig', { entry: entry }) : null -%}
        {%- set items = items | merge([{
            title: entry.type ~ (entry.occurrences > 1 ? ' ×' ~ entry.occurrences : ''),
            meta: entry.category ~ ' · ' ~ entry.occurredAt | date('Y-m-d H:i') ~ (entry.actorId ? ' · ' ~ (entry.actorLabel ?: (domain ~ 'by_someone_else') | trans) : ''),
            tone: entry.type matches '/(failed|denied|refused|expired|error|exceeded)/' ? 'danger' : null,
            body: body,
        }]) -%}
    {%- endfor -%}
    {{ component(render_pass, '@WexampleSymfonyDesignSystemBundle/components/timeline', {}, { items: items }) }}
{%- endif -%}
