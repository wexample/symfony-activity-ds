{
  "name": "wexample/symfony-activity-ds",
  "version": "2.0.5",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyActivityDs\\": "src/"
    }
  },
  "description": "Design-system screens for symfony-activity: the history of a subject, as a recent timeline and a paged table",
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "wexample/symfony-activity": ">=3.0.0",
    "wexample/symfony-design-system": ">=37.0.0",
    "wexample/symfony-helpers": ">=17.0.0",
    "wexample/symfony-loader": ">=23.2.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}